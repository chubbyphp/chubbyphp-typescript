{
    "source": {
        "directories": [
            "src"
        ]
    },
    "timeout": 10,
    "logs": {
        "text": "build/phpinfection/infection.log",
        "html": "build/phpinfection/infection.html",
        "json": "build/phpinfection/infection.json",
        "summary": "build/phpinfection/summary.log",
        "stryker": {
            "report": "master"
        }
    },
    "mutators": {
        "@default": true,
        "DecrementInteger": {
            "ignoreSourceCodeByRegex": [
                "if \\(\\(2 \\*\\* 32\\) - 1 < \\$argument\\) \\{",
                "\\$final = \\$relativeEnd < 0 \\? max\\(\\$len \\+ \\$relativeEnd, 0\\) : min\\(\\$relativeEnd, \\$len\\);"
            ]
        },
        "IncrementInteger": {
            "ignoreSourceCodeByRegex": [
                "if \\(\\(2 \\*\\* 32\\) - 1 < \\$argument\\) \\{"
            ]
        },
        "LessThan": {
            "ignoreSourceCodeByRegex": [
                "if \\(\\(2 \\*\\* 32\\) - 1 < \\$argument\\) \\{",
                "if \\(0 < \\$count\\) \\{"
            ]
        }
    }
}
